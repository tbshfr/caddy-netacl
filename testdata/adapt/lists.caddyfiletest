{
	netacl {
		lists_url https://raw.githubusercontent.com/example/caddy-netacl/main/lists
		group github list github/hooks github/actions
	}
}

:8080 {
	netacl {
		allow @github
		deny list example/blocklist ip 192.0.2.1
		default deny
	}
	respond "ok"
}
----------
{
	"apps": {
		"http": {
			"servers": {
				"srv0": {
					"listen": [
						":8080"
					],
					"routes": [
						{
							"handle": [
								{
									"default": "deny",
									"handler": "netacl",
									"rules": [
										{
											"action": "allow",
											"groups": [
												"github"
											]
										},
										{
											"action": "deny",
											"ips": [
												"192.0.2.1"
											],
											"lists": [
												"example/blocklist"
											]
										}
									]
								},
								{
									"body": "ok",
									"handler": "static_response"
								}
							]
						}
					]
				}
			}
		},
		"netacl": {
			"groups": {
				"github": {
					"lists": [
						"github/hooks",
						"github/actions"
					]
				}
			},
			"lists_url": "https://raw.githubusercontent.com/example/caddy-netacl/main/lists"
		}
	}
}
